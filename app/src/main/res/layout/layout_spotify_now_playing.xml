<?xml version="1.0" encoding="utf-8"?>
<!-- Full-width native Now Playing UI. This occupies the app area, not Ford's
     system chrome or Flywheel's persistent navigation/media dock. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/spotify_now_playing"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/spotify_player_background"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="30dp"
        android:paddingVertical="20dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.39"
            android:layout_marginEnd="28dp">

            <ImageView
                android:id="@+id/spotify_player_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginVertical="14dp"
                android:background="@drawable/spotify_player_art_frame"
                android:clipToOutline="true"
                android:contentDescription="Album artwork"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/music" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.61"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.15"
                    android:text="SPOTIFY  /  NOW PLAYING"
                    android:textColor="@color/home_mint"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/spotify_player_browse"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:background="@drawable/spotify_player_browse_button"
                    android:clickable="true"
                    android:contentDescription="Back to Spotify music selection"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="&#x2190;  Back to Spotify"
                    android:textColor="@color/home_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/spotify_player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Open Spotify to play music"
                android:textColor="@color/home_text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/spotify_player_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Your music will appear here"
                android:textColor="@color/home_secondary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/spotify_player_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/home_muted"
                android:textSize="15sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <SeekBar
                android:id="@+id/spotify_player_seek"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:progressTint="@color/home_mint"
                android:thumbTint="@color/home_mint"
                android:progress="0"
                android:max="1000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/spotify_player_elapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="@color/home_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/spotify_player_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="@color/home_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/spotify_player_previous"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/selectable_item_background_circular"
                    android:contentDescription="Previous track"
                    android:src="@drawable/skip_previous"
                    app:tint="@color/home_text" />

                <ImageButton
                    android:id="@+id/spotify_player_play_pause"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginHorizontal="30dp"
                    android:background="@drawable/spotify_player_play_button"
                    android:contentDescription="Play or pause"
                    android:padding="20dp"
                    android:src="@drawable/play_arrow"
                    app:tint="@color/home_dark_text" />

                <ImageButton
                    android:id="@+id/spotify_player_next"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/selectable_item_background_circular"
                    android:contentDescription="Next track"
                    android:src="@drawable/skip_next"
                    app:tint="@color/home_text" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
