<resources>
    <style name="Base.Theme.Geargrinder" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorDockBackground">#151D27</item>
        <item name="colorDockForeground">@color/home_text</item>
        <item name="colorDockContainer">#26343E</item>
        <item name="colorDockItemInactive">#43515B</item>
        <item name="colorDockItemActive">@color/home_mint</item>
        <item name="colorFocusIndicatorInactive">#333333</item>
        <item name="colorFocusIndicatorActive">@color/home_mint</item>

        <item name="colorAppModalForeground">?android:windowBackground</item>
        <item name="colorAppModalBackground">?attr/colorSurfaceContainer</item>

        <item name="colorAcceptCallButton">#23A023</item>
        <item name="colorRejectCallButton">#9E3434</item>

        <item name="dynamicColorThemeOverlay">@style/ThemeOverlay.Geargrinder.DynamicColors</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Geargrinder.AlertDialog</item>
        <item name="tabStyle">@style/Widget.Material3.TabLayout</item>
    </style>

    <style name="Base.ThemeOverlay.Geargrinder.DynamicColors" parent="@style/ThemeOverlay.Material3.DynamicColors.DayNight">
        <item name="colorDockForeground">@color/material_dynamic_neutral_variant99</item>
        <item name="colorDockBackground">@color/material_dynamic_neutral_variant10</item>
        <item name="colorDockContainer">@color/material_dynamic_neutral20</item>
        <item name="colorDockItemInactive">@color/material_dynamic_neutral40</item>
        <item name="colorDockItemActive">@color/material_dynamic_primary70</item>
        <item name="colorFocusIndicatorInactive">@color/material_dynamic_neutral20</item>
        <item name="colorFocusIndicatorActive">@color/material_dynamic_primary70</item>

        <item name="colorAppModalForeground">@color/material_dynamic_neutral99</item>
        <item name="colorAppModalBackground">@color/material_dynamic_neutral90</item>

    </style>

    <style name="ThemeOverlay.Geargrinder.AlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorBackgroundFloating">@macro/m3_comp_dialog_container_color</item>
    </style>

    <style name="Theme.Geargrinder" parent="Base.Theme.Geargrinder" />
    <style name="ThemeOverlay.Geargrinder.DynamicColors" parent="Base.ThemeOverlay.Geargrinder.DynamicColors" />


    <style name="Theme.Geargrinder.ScreenWakeActivity" parent="Theme.Geargrinder">
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
    </style>

    <style name="Theme.Geargrinder.Projection" parent="Theme.Geargrinder">
    </style>

    <style name="Theme.Geargrinder.Invisible" parent="Theme.Geargrinder">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">#00000000</item>
    </style>
</resources>